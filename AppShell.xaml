<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="journal2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:journal2"
    Title="journal2"

    Shell.FlyoutBehavior="Flyout"
    Shell.TabBarIsVisible="True">
    <!-- define new pages here-->
    <Shell.FlyoutHeader>
        <VerticalStackLayout>
            <Image Source ="dotnet_bot.png" >
            </Image>
            <Label Text="Header">
            </Label>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!--These items are new starting points in the navigation stack. buttons that pop from here wont do anything-->
    <FlyoutItem Title = "Dashboard" 
                FlyoutDisplayOptions = "AsMultipleItems">
        <ShellContent
             Title="HOME"
             ContentTemplate="{DataTemplate local:MainPage}"
             Route="home" />

        <ShellContent
             Title="Writing Area"
             ContentTemplate="{DataTemplate local:WritingArea}"
             Route="write" />

        <ShellContent
             Title="Search Page"
             ContentTemplate="{DataTemplate local:SearchPage}"
             Route="search" />
        
    </FlyoutItem>


    

</Shell>
