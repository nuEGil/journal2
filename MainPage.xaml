<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="journal2.MainPage">

    <AbsoluteLayout>
       
        <!-- Scrollable content -->
        <CollectionView x:Name="FileList" 
                            ItemsSource="{Binding Files}"
                            SelectionMode = "Single"
                            SelectionChanged = "OnFileSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Margin="5"
                        BackgroundColor="{Binding BubbleColor}"
                        HorizontalOptions="{Binding Alignment}">
                        <Label Text="{Binding Name}" 
                            TextColor="Black"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    

        <!-- Floating circular button -->
        <Button
                AbsoluteLayout.LayoutFlags="PositionProportional"
                AbsoluteLayout.LayoutBounds="0.9,1,60,60"
                Text="+"
                FontSize="28"
                CornerRadius="30"
                BackgroundColor="#007AFF"
                TextColor="White"
                Clicked="OnNextPageClicked" />
        
    </AbsoluteLayout>
</ContentPage>
